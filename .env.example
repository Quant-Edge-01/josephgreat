# Sends the enquiry form to EMAIL in lib/site.ts.
# resend.com -> API Keys.
#
# Verify the SUBDOMAIN send.josephthegreat.art in Resend, not the root domain:
# josephthegreat.art already carries Private Email's SPF record, and a second
# SPF entry on the same name would collide. app/api/enquiry/route.ts sends from
# enquiry@send.josephthegreat.art, so that is the name the DNS records go on.
# Replies are pointed back at EMAIL, since the subdomain has no inbox.
RESEND_API_KEY=

# Meta Events Manager -> Data Sources -> your pixel -> the numeric ID.
# If this is unset the site renders no pixel at all and still works.
NEXT_PUBLIC_META_PIXEL_ID=
