# Sends the enquiry form to EMAIL in lib/site.ts.
# resend.com -> API Keys. Verify josephthegreat.art as a sending domain first,
# otherwise Resend rejects the `from` address used in app/api/enquiry/route.ts.
RESEND_API_KEY=

# Meta Events Manager -> Data Sources -> your pixel -> the numeric ID.
# If this is unset the site renders no pixel at all and still works.
NEXT_PUBLIC_META_PIXEL_ID=
