# Delivers the enquiry form to EMAIL in lib/site.ts.
#
# web3forms.com -> paste the destination address -> the access key arrives in
# that inbox. No account, no DNS records: the destination is bound to the key.
#
# NEXT_PUBLIC_ on purpose. Web3Forms rejects server-side calls on the free plan
# ("This method is not allowed. Use our API in client side"), so the browser is
# the sender and the key ships in the bundle. That is their intended model: the
# key can only ever deliver to the one inbox it was issued for, and abuse is
# fenced off by restricting the allowed domain in the Web3Forms dashboard —
# do that after deploying, or anyone can post to it from anywhere.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Meta Events Manager -> Data Sources -> your pixel -> the numeric ID.
# If this is unset the site renders no pixel at all and still works.
NEXT_PUBLIC_META_PIXEL_ID=
